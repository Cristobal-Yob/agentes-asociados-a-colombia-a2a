# Reference only: never commit a populated credential file or load one in the browser.
# Google Web OAuth, not the Gmail desktop client. The owner allowlist is required explicit server configuration.
COLOMBIA_UI_ORIGIN=
COLOMBIA_UI_GOOGLE_CLIENT_ID=
COLOMBIA_UI_GOOGLE_CLIENT_SECRET=
COLOMBIA_UI_FIRESTORE_PROJECT=YOUR_FIRESTORE_PROJECT_ID
COLOMBIA_UI_FIRESTORE_DATABASE=
COLOMBIA_UI_ITINERARY_KEY=
COLOMBIA_UI_EMAIL_KEY=
PORT=8110

# Required explicit own-account identity and fixed server-side destinations.
COLOMBIA_UI_ALLOWED_EMAIL=
COLOMBIA_UI_ITINERARY_URL=
COLOMBIA_UI_EMAIL_URL=
COLOMBIA_UI_HUB_RETURN=
COLOMBIA_UI_SENDER_EMAIL=
