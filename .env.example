# Solo documentación: los puntos de entrada de Python no cargan archivos .env automáticamente.
# La clase usa ADC autorizadas por defecto, nunca GOOGLE_API_KEY ni GEMINI_API_KEY.
MODEL_MODE=vertex
VERTEX_PROJECT_ID=example-project
VERTEX_LOCATION=global
MODEL_ID=gemini-3.1-flash-lite
MODEL_CALL_LIMIT=100
ENABLE_MCP=false
PEER_USE_IAM=false
EMAIL_AGENT_URL=http://127.0.0.1:8002
# Use 8002 para el servicio de correo.
PUBLIC_AGENT_URL=http://127.0.0.1:8001
# Gmail está seleccionado; autorice primero la cuenta personal con el asistente OAuth.
EMAIL_TRANSPORT=gmail
EMAIL_SENDER=student@example.com
GMAIL_CREDENTIALS_FILE=../../work/gmail-oauth-personal/authorized-user.json
GMAIL_LEDGER=sqlite
GMAIL_LEDGER_PATH=../../work/gmail-dispatch.sqlite
# Cloud Run debe usar gcs con este bucket dedicado, sujeto a aprobación independiente:
GMAIL_LEDGER_BUCKET=example-project-email-agent-ledger
ENABLE_REAL_EMAIL=true
APPROVAL_SIGNING_KEY=
# Solo si se selecciona Resend explícitamente y se verifica el dominio exacto del remitente:
RESEND_API_KEY=
