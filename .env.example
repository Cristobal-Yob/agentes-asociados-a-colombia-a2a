# Reference only. Python entry points do not load .env files automatically.
# Docker Compose does read .env; keep the offline defaults for inspection.
# Runtime defaults are also fixture/mock; live adapters require explicit opt-in.
MODEL_MODE=fixture
EMAIL_TRANSPORT=mock
EMAIL_SENDER=classroom@example.invalid
ENABLE_REAL_EMAIL=false
ENABLE_MCP=false
PEER_USE_IAM=false
MODEL_CALL_LIMIT=5
VERTEX_PROJECT_ID=YOUR_VERTEX_PROJECT_ID
VERTEX_LOCATION=global
MODEL_ID=gemini-3.1-flash-lite
EMAIL_AGENT_URL=http://127.0.0.1:8002
AGENDA_AGENT_URL=http://127.0.0.1:8003
PUBLIC_AGENT_URL=http://127.0.0.1:8001

# Generate distinct service keys outside the repository. Never use a published
# example value as a credential. Empty keys fail closed on business APIs.
AGENT_API_KEY=
EMAIL_AGENT_API_KEY=
AGENDA_AGENT_API_KEY=
# Compose role-specific names (Python uses AGENT_API_KEY for its current role).
TOURISM_API_KEY=
EMAIL_API_KEY=
AGENDA_API_KEY=
APPROVAL_SIGNING_KEY=
AGENDA_APPROVAL_SIGNING_KEY=
WORKFLOW_STORE=sqlite
WORKFLOW_DB_PATH=
WORKFLOW_FIRESTORE_PROJECT=YOUR_FIRESTORE_PROJECT_ID
WORKFLOW_FIRESTORE_DATABASE=YOUR_DEDICATED_DATABASE

# Live credentials require separate authorization and private absolute paths.
# These entries do not enable Gmail/Calendar or make this owner-pinned deployment
# a generic bring-your-own-cloud template. Read docs/public-release.md first.
GMAIL_EXPECTED_EMAIL=
GMAIL_OAUTH_PROJECT=
GMAIL_CREDENTIALS_FILE=
GMAIL_LEDGER=sqlite
GMAIL_LEDGER_PATH=
GMAIL_LEDGER_BUCKET=YOUR_DEDICATED_LEDGER_BUCKET
CALENDAR_CREDENTIALS_FILE=
CALENDAR_LEDGER_PATH=
RESEND_API_KEY=
