{
  "$defs": {
    "AgendaEvent": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "title",
        "start",
        "end",
        "timezone"
      ],
      "title": "AgendaEvent",
      "type": "object"
    },
    "AgendaPreview": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "calendar_id": {
          "const": "primary",
          "default": "primary",
          "title": "Calendar Id",
          "type": "string"
        },
        "account": {
          "maxLength": 254,
          "minLength": 3,
          "title": "Account",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/AgendaEvent"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "recipient": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient"
        },
        "mail_requested": {
          "default": false,
          "title": "Mail Requested",
          "type": "boolean"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "integer"
        }
      },
      "required": [
        "plan_id",
        "session_id",
        "events",
        "expires_at"
      ],
      "title": "AgendaPreview",
      "type": "object"
    },
    "AgendaSpec": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fecha inicial"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zona horaria IANA"
        },
        "start_time": {
          "anyOf": [
            {
              "pattern": "^\\d{2}:\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hora local inicial"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionSpec"
          },
          "maxItems": 7,
          "title": "Actividades",
          "type": "array"
        }
      },
      "title": "AgendaSpec",
      "type": "object"
    },
    "CreatedEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "link": {
          "title": "Link",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "start",
        "end",
        "link"
      ],
      "title": "CreatedEvent",
      "type": "object"
    },
    "PendingAgendaPlan": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/AgendaSpec"
        },
        "recipient": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient"
        },
        "mail_requested": {
          "default": false,
          "title": "Mail Requested",
          "type": "boolean"
        }
      },
      "required": [
        "spec"
      ],
      "title": "PendingAgendaPlan",
      "type": "object"
    },
    "SessionSpec": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Actividad",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 480,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duraci\u00f3n en minutos"
        },
        "day_offset": {
          "default": 0,
          "maximum": 6,
          "minimum": 0,
          "title": "D\u00edas desde la fecha inicial",
          "type": "integer"
        }
      },
      "required": [
        "title"
      ],
      "title": "SessionSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solicitud durable"
    },
    "plan_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Versi\u00f3n del plan"
    },
    "operation_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operaci\u00f3n idempotente"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sesi\u00f3n de la solicitud"
    },
    "workflow_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estado durable"
    },
    "a2a_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tarea A2A remota"
    },
    "a2a_context_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contexto A2A remoto"
    },
    "status": {
      "enum": [
        "completed",
        "clarification",
        "preview",
        "created",
        "conflict",
        "creation_unknown",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgendaPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingAgendaPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "events": {
      "items": {
        "$ref": "#/$defs/CreatedEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "missing_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Field"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "email": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email"
    }
  },
  "required": [
    "status",
    "message"
  ],
  "title": "AgendaResponse",
  "type": "object"
}
