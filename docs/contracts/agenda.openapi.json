      },
      "AuthenticationInfo": {
        "type": "object",
        "properties": {
          "scheme": {
            "type": "string",
            "example": "scheme"
          },
          "credentials": {
            "type": "string",
            "example": ""
          }
        }
      },
      "GetTaskRequest": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "example": ""
          },
          "id": {
            "type": "string",
            "example": "id"
          },
          "history_length": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ListTasksRequest": {
        "type": "object",
        "properties": {
          "tenant": {
