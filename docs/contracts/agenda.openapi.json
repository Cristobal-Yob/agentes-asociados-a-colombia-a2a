                ]
              },
              {
                "type": "object",
                "properties": {
                  "raw": {
                    "type": "string",
                    "format": "byte"
                  }
                },
                "required": [
                  "raw"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "example": ""
                  }
                },
                "required": [
