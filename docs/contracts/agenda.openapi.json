            "example": ""
          },
          "task_id": {
            "type": "string",
            "example": ""
          },
          "url": {
            "type": "string",
            "example": "url"
          },
          "token": {
            "type": "string",
            "example": ""
          },
          "authentication": {
            "oneOf": [
