                ]
              },
              {
                "type": "object",
                "properties": {
                  "data": {}
                },
                "required": [
                  "data"
                ]
              }
            ]
          }
        ],
        "example": {
          "text": ""
        }
      },
      "SendMessageConfiguration": {
        "type": "object",
        "properties": {
          "accepted_output_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "example": ""
            },
            "example": [
              ""
            ]
          },
          "task_push_notification_config": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TaskPushNotificationConfig"
              },
