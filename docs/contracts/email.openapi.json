{
  "openapi": "3.1.0",
  "info": {
    "title": "Agente independiente de correo",
    "description": "Redacta correos de cualquier tema a partir de una solicitud directa y un destinatario expl\u00edcito; tambi\u00e9n puede recibir un itinerario. No requiere conectarse a turismo. Una orden expl\u00edcita de redactar y enviar con datos suficientes permite enviar desde student@example.com en ese turno. Los borradores requieren una confirmaci\u00f3n posterior. La aceptaci\u00f3n del proveedor no garantiza la llegada al buz\u00f3n.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Estado"
        ],
        "summary": "Consultar el estado del agente",
        "description": "Comprueba que la API responde. No consulta modelos ni proveedores externos.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Estado del agente",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "Conversaci\u00f3n"
        ],
        "summary": "Conversar, redactar y enviar desde su Gmail personal",
        "description": "Env\u00ede solo message. Si la respuesta incluye context, devu\u00e9lvalo intacto junto con el siguiente message. Una orden expl\u00edcita de env\u00edo con destinatario y contenido suficientes redacta y env\u00eda en el mismo turno. Pedir solo redactar devuelve una vista previa; en ese caso \u00abS\u00ed, env\u00edalo\u00bb con context confirma el texto exacto.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailChatRequest"
              },
              "examples": {
                "primera_solicitud": {
                  "summary": "Primer mensaje, sin contexto previo",
                  "value": {
                    "message": "Env\u00eda a persona@example.com un recordatorio de la reuni\u00f3n de ma\u00f1ana."
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Aclaraci\u00f3n, vista previa pendiente de confirmaci\u00f3n o resultado real",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailResponse"
                },
                "examples": {
                  "vista_previa": {
                    "summary": "Vista previa ilustrativa, sin autorizaci\u00f3n ni env\u00edo",
                    "value": {
                      "status": "preview",
                      "message": "Ejemplo ilustrativo: revise la vista previa real y devuelva su context antes de confirmar. Este ejemplo no contiene una aprobaci\u00f3n v\u00e1lida.",
                      "conversation_state": "awaiting_confirmation",
                      "preview": {
                        "draft_id": "BORRADOR_ILUSTRATIVO",
                        "session_id": "SESION_ILUSTRATIVA",
                        "recipient": "persona@example.com",
                        "subject": "Recordatorio de reuni\u00f3n",
                        "text": "Le recordamos la reuni\u00f3n de ma\u00f1ana.",
                        "transport": "gmail",
                        "sender": "REMITENTE_CONFIGURADO",
                        "expires_at": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/email": {
      "post": {
        "tags": [
          "Correo"
        ],
        "summary": "Preparar o confirmar un correo",
        "description": "action=draft prepara una vista previa. Para action=send, use la misma sesi\u00f3n, la vista previa y el token firmados sin modificarlos, y confirmed=true antes del vencimiento. Una solicitud de borrador nunca autoriza un env\u00edo.",
        "operationId": "email_api_email_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Vista previa, resultado del env\u00edo, solicitud de aclaraci\u00f3n o error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/agent-card.json": {
      "get": {
        "tags": [
          "A2A: Agent Card"
        ],
        "summary": " Get Agent Card",
        "description": "Returns the public AgentCard describing this agent's capabilities, supported transports, and skills.",
        "operationId": "_get_agent_card__well_known_agent_card_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/a2a": {
      "post": {
        "tags": [
          "A2A: JSON-RPC"
        ],
        "summary": "A2A JSON-RPC endpoint",
        "description": "A2A JSON-RPC 2.0 endpoint. The `method` field selects the operation;\n`params` must match that method's schema (see the `oneOf` below).\n\n**Supported methods:**\n\n- `SendMessage` \u2014 Send a message to the agent (returns a Task or response Message).\n- `SendStreamingMessage` \u2014 Send a message and receive a Server-Sent Events stream.\n- `GetTask` \u2014 Fetch a task by ID.\n- `ListTasks` \u2014 List tasks with pagination and filtering.\n- `CancelTask` \u2014 Cancel an in-progress task.\n- `CreateTaskPushNotificationConfig` \u2014 Register a push-notification config on a task.\n- `GetTaskPushNotificationConfig` \u2014 Read a single push-notification config.\n- `ListTaskPushNotificationConfigs` \u2014 List all push-notification configs for a task.\n- `DeleteTaskPushNotificationConfig` \u2014 Delete a push-notification config.\n- `SubscribeToTask` \u2014 Subscribe to task events via Server-Sent Events.\n- `GetExtendedAgentCard` \u2014 Fetch the authenticated extended agent card.\n",
        "operationId": "handle_requests_a2a_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "requestBody": {
          "description": "A2A JSON-RPC 2.0 request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/A2ARequest"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "A2A-Version",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1.0"
              ]
            },
            "example": "1.0"
          }
        ]
      }
    }
  },
  "components": {
