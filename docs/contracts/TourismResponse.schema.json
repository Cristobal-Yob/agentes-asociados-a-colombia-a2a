{
  "$defs": {
    "AgendaEvent": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "title",
        "start",
        "end",
        "timezone"
      ],
      "title": "AgendaEvent",
      "type": "object"
    },
    "AgendaPreview": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "calendar_id": {
          "const": "primary",
          "default": "primary",
          "title": "Calendar Id",
          "type": "string"
        },
        "account": {
          "maxLength": 254,
          "minLength": 3,
          "title": "Account",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/AgendaEvent"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "recipient": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient"
        },
        "mail_requested": {
          "default": false,
          "title": "Mail Requested",
          "type": "boolean"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "integer"
        }
      },
      "required": [
        "plan_id",
        "session_id",
        "events",
        "expires_at"
      ],
      "title": "AgendaPreview",
      "type": "object"
    },
    "AgendaResponse": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solicitud durable"
        },
        "plan_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Versi\u00f3n del plan"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operaci\u00f3n idempotente"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sesi\u00f3n de la solicitud"
        },
        "workflow_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estado durable"
        },
        "a2a_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tarea A2A remota"
        },
        "a2a_context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contexto A2A remoto"
        },
        "status": {
          "enum": [
            "completed",
            "clarification",
            "preview",
            "created",
            "conflict",
            "creation_unknown",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgendaPreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pending_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingAgendaPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "events": {
          "items": {
            "$ref": "#/$defs/CreatedEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "missing_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Field"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "email": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        }
      },
      "required": [
        "status",
        "message"
      ],
      "title": "AgendaResponse",
      "type": "object"
    },
    "AgendaSpec": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fecha inicial"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zona horaria IANA"
        },
        "start_time": {
          "anyOf": [
            {
              "pattern": "^\\d{2}:\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hora local inicial"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionSpec"
          },
          "maxItems": 7,
          "title": "Actividades",
          "type": "array"
        }
      },
      "title": "AgendaSpec",
      "type": "object"
    },
    "CreatedEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "link": {
          "title": "Link",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "start",
        "end",
        "link"
      ],
      "title": "CreatedEvent",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "title": "D\u00eda",
          "type": "integer"
        },
        "activities": {
          "items": {
            "type": "string"
          },
          "title": "Actividades",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Identificadores de las fuentes",
          "type": "array"
        }
      },
      "required": [
        "day",
        "activities",
        "source_ids"
      ],
      "title": "D\u00eda del itinerario",
      "type": "object"
    },
    "EmailContent": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "Asunto exacto",
          "type": "string"
        },
        "text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Texto exacto",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "text"
      ],
      "title": "EmailContent",
      "type": "object"
    },
    "EmailPreview": {
      "additionalProperties": false,
      "properties": {
        "plan_version": {
          "default": 1,
          "minimum": 1,
          "title": "Versi\u00f3n aprobada",
          "type": "integer"
        },
        "draft_id": {
          "title": "Identificador del borrador",
          "type": "string"
        },
        "session_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Sesi\u00f3n",
          "type": "string"
        },
        "recipient": {
          "examples": [
            "student@example.com"
          ],
          "format": "email",
          "title": "Destinatario",
          "type": "string"
        },
        "subject": {
          "description": "Asunto exacto incluido en la aprobaci\u00f3n firmada.",
          "examples": [
            "Tu itinerario en Colombia"
          ],
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "Asunto",
          "type": "string"
        },
        "text": {
          "description": "Contenido exacto incluido en la aprobaci\u00f3n firmada.",
          "maxLength": 12000,
          "minLength": 1,
          "title": "Texto",
          "type": "string"
        },
        "transport": {
          "enum": [
            "mock",
            "resend",
            "gmail"
          ],
          "title": "Transporte del correo",
          "type": "string"
        },
        "sender": {
          "maxLength": 200,
          "title": "Remitente",
          "type": "string"
        },
        "expires_at": {
          "description": "Instante de vencimiento de la aprobaci\u00f3n, en segundos Unix.",
          "title": "Vencimiento",
          "type": "integer"
        }
      },
      "required": [
        "draft_id",
        "session_id",
        "recipient",
        "subject",
        "text",
        "transport",
        "sender",
        "expires_at"
      ],
      "title": "Vista previa del correo",
      "type": "object"
    },
    "EmailResponse": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solicitud durable"
        },
        "plan_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Versi\u00f3n del plan"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operaci\u00f3n idempotente"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sesi\u00f3n de la solicitud"
        },
        "workflow_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estado durable"
        },
        "a2a_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tarea A2A remota"
        },
        "a2a_context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contexto A2A remoto"
        },
        "status": {
          "description": "Resultado del procesamiento; sent no garantiza llegada al buz\u00f3n.",
          "enum": [
            "preview",
            "simulated",
            "sent",
            "delivery_unknown",
            "error",
            "clarification",
            "completed",
            "cancelled"
          ],
          "title": "Estado",
          "type": "string"
        },
        "message": {
          "title": "Mensaje",
          "type": "string"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Asunto y texto redactados, sin aprobaci\u00f3n ni autorizaci\u00f3n de env\u00edo.",
          "title": "Redacci\u00f3n sin env\u00edo"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailPreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vista previa"
        },
        "approval_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token de aprobaci\u00f3n"
        },
        "delivery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resultado del env\u00edo"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "C\u00f3digo de error"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contexto opaco para el siguiente mensaje"
        },
        "conversation_state": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "awaiting_confirmation",
                "sent",
                "failed",
                "completed",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estado de la conversaci\u00f3n"
        }
      },
      "required": [
        "status",
        "message"
      ],
      "title": "Respuesta del agente de correo",
      "type": "object"
    },
    "Itinerary": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "title": "Ciudad",
          "type": "string"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/Day"
          },
          "title": "D\u00edas y actividades",
          "type": "array"
        },
        "summary": {
          "maxLength": 3000,
          "title": "Resumen",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Fuentes",
          "type": "array"
        },
        "warnings": {
          "description": "L\u00edmites de las sugerencias.",
          "items": {
            "type": "string"
          },
          "title": "Advertencias",
          "type": "array"
        },
        "model_mode": {
          "description": "Modo de ejecuci\u00f3n utilizado.",
          "title": "Modo del modelo",
          "type": "string"
        }
      },
      "required": [
        "city",
        "days",
        "summary",
        "sources",
        "warnings",
        "model_mode"
      ],
      "title": "Itinerario",
      "type": "object"
    },
    "PendingAgendaPlan": {
      "additionalProperties": false,
      "properties": {
        "spec": {
          "$ref": "#/$defs/AgendaSpec"
        },
        "recipient": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient"
        },
        "mail_requested": {
          "default": false,
          "title": "Mail Requested",
          "type": "boolean"
        }
      },
      "required": [
        "spec"
      ],
      "title": "PendingAgendaPlan",
      "type": "object"
    },
    "SessionSpec": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Actividad",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 480,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duraci\u00f3n en minutos"
        },
        "day_offset": {
          "default": 0,
          "maximum": 6,
          "minimum": 0,
          "title": "D\u00edas desde la fecha inicial",
          "type": "integer"
        }
      },
      "required": [
        "title"
      ],
      "title": "SessionSpec",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identificador original de la fuente.",
          "title": "Identificador",
          "type": "string"
        },
        "name": {
          "description": "Nombre de la actividad en el cat\u00e1logo de origen.",
          "title": "Nombre",
          "type": "string"
        },
        "city": {
          "title": "Ciudad",
          "type": "string"
        },
        "url": {
          "description": "Enlace de referencia de la fuente.",
          "title": "Enlace",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fecha de consulta en vivo; nula para datos de ejemplo.",
          "title": "Fecha de consulta"
        },
        "fixture_as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fecha de los datos de ejemplo"
        },
        "source_reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fecha de revisi\u00f3n de la fuente"
        },
        "provenance": {
          "description": "Datos de ejemplo revisados o registros de MCP en vivo.",
          "enum": [
            "curated_fixture",
            "live_mcp"
          ],
          "title": "Procedencia",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "city",
        "url",
        "retrieved_at",
        "provenance"
      ],
      "title": "Fuente",
      "type": "object"
    },
    "TripContext": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solicitud durable"
        },
        "plan_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Versi\u00f3n del plan"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operaci\u00f3n idempotente"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ciudad que se desea visitar.",
          "examples": [
            "Bogot\u00e1"
          ],
          "title": "Ciudad"
        },
        "days": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duraci\u00f3n de la visita, de 1 a 7 d\u00edas.",
          "examples": [
            2
          ],
          "title": "D\u00edas"
        },
        "interests": {
          "description": "Intereses del viaje. Los valores del contrato conservan sus nombres originales.",
          "examples": [
            [
              "culture",
              "nature"
            ]
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Intereses",
          "type": "array"
        },
        "draft_email": {
          "default": false,
          "description": "Conserva la solicitud expl\u00edcita de correo durante las aclaraciones. Nunca autoriza el env\u00edo y se desactiva al obtener la vista previa.",
          "title": "Solicitud de borrador pendiente",
          "type": "boolean"
        },
        "recipient": {
          "anyOf": [
            {
              "format": "email",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Destinatario expl\u00edcito conservado entre turnos; no se infiere de fuentes.",
          "examples": [
            "persona@example.com"
          ],
          "title": "Destinatario indicado"
        },
        "email_context": {
          "anyOf": [
            {
